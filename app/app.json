{
  "expo": {
    "name": "时纪流",
    "slug": "chronoflow",
    "version": "1.1.8",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.chronoflow.frontend",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "用于在地图选点中定位到你的当前位置"
      }
    },
    "android": {
      "package": "com.chronoflow.frontend",
      "versionCode": 33,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "REQUEST_INSTALL_PACKAGES",
        "SYSTEM_ALERT_WINDOW",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#21221D"
      },
      "blockedPermissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_PHONE_STATE",
        "android.permission.QUERY_ALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用于在地图选点中定位到你的当前位置"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "用于选择头像、为待办或意见反馈添加图片",
          "cameraPermission": "用于拍一张日程通知/行程单，在手机本地识别成日程草稿"
        }
      ],
      [
        "./plugins/withJpush",
        {
          "appKey": "e45cb28aabd482c0dcc6ab42",
          "channel": "default_developer"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "用于长按说话：把您说的一句话转成文字，再识别成日程草稿",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "./plugins/withPcmRecorder",
      "./plugins/withCleartextHttp",
      "./plugins/withOnnxRuntime",
      "./plugins/withSystemLocation",
      "./plugins/withTaskBarNotification",
      "./plugins/withShareImageImport",
      "./plugins/withReleaseSigning",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#21221D"
          }
        }
      ],
      "onnxruntime-react-native"
    ],
    "extra": {
      "apiBaseUrl": "https://chronocloud.top"
    }
  }
}
