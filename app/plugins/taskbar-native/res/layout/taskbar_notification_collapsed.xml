<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/taskbar_notification_root"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="4dp"
  android:paddingTop="2dp"
  android:paddingEnd="4dp"
  android:paddingBottom="2dp"
  android:background="@drawable/taskbar_notification_bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="30dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <ImageView
      android:id="@+id/taskbar_bar"
      android:layout_width="30dp"
      android:layout_height="30dp"
      android:layout_marginEnd="6dp"
      android:contentDescription="打开时纪流"
      android:padding="2dp"
      android:scaleType="fitCenter"
      android:src="@mipmap/ic_launcher" />

    <TextView
      android:id="@+id/taskbar_headline"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="任务总览"
      android:textColor="#25262A"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/taskbar_nearest"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#6B6B6B"
      android:textSize="9sp"
      android:text="最近 · 暂无安排" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="14dp"
    android:layout_marginTop="2dp"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/taskbar_group_row_urgent"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="2dp"
      android:layout_weight="1"
      android:contentDescription="紧急任务"
      android:scaleType="fitXY" />

    <ImageView
      android:id="@+id/taskbar_group_row_soon"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="2dp"
      android:layout_weight="1"
      android:contentDescription="临近任务"
      android:scaleType="fitXY" />

    <ImageView
      android:id="@+id/taskbar_group_row_calm"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:contentDescription="从容任务"
      android:scaleType="fitXY" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/taskbar_compact_legend"
    android:layout_width="match_parent"
    android:layout_height="9dp"
    android:layout_marginTop="1dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp">

    <TextView
      android:id="@+id/taskbar_legend_urgent"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="● 紧急 0"
      android:textColor="#B3352F"
      android:textSize="8sp" />

    <TextView
      android:id="@+id/taskbar_legend_soon"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="● 临近 0"
      android:textColor="#B58500"
      android:textSize="8sp" />

    <TextView
      android:id="@+id/taskbar_legend_calm"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="● 从容 0"
      android:textColor="#2E7D5B"
      android:textSize="8sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/taskbar_compact_task"
    android:layout_width="match_parent"
    android:layout_height="18dp"
    android:layout_marginTop="1dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:visibility="gone">

    <TextView
      android:id="@+id/taskbar_compact_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:textColor="#25262A"
      android:textSize="10.5sp" />

    <TextView
      android:id="@+id/taskbar_compact_when"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="5dp"
      android:maxLines="1"
      android:textColor="#6B6B6B"
      android:textSize="8.5sp" />

    <TextView
      android:id="@+id/taskbar_compact_circle"
      android:layout_width="24dp"
      android:layout_height="18dp"
      android:gravity="center"
      android:text="○"
      android:textColor="#B3352F"
      android:textSize="14sp" />
  </LinearLayout>
</LinearLayout>
