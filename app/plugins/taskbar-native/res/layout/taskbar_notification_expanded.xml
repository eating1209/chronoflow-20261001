<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/taskbar_notification_root"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:padding="4dp"
  android:background="@drawable/taskbar_notification_bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <ImageView
      android:id="@+id/taskbar_bar"
      android:layout_width="30dp"
      android:layout_height="30dp"
      android:layout_marginEnd="6dp"
      android:contentDescription="打开时纪流"
      android:padding="2dp"
      android:scaleType="fitCenter"
      android:src="@mipmap/ic_launcher" />

    <TextView
      android:id="@+id/taskbar_headline"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="任务"
      android:textColor="#25262A"
      android:textSize="13sp" />

    <TextView
      android:id="@+id/taskbar_nearest"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#6B6B6B"
      android:textSize="9.5sp" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="24dp"
    android:layout_marginTop="5dp"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/taskbar_group_row_urgent"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="2dp"
      android:layout_weight="1"
      android:contentDescription="紧急任务"
      android:scaleType="fitXY" />

    <ImageView
      android:id="@+id/taskbar_group_row_soon"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="2dp"
      android:layout_weight="1"
      android:contentDescription="临近任务"
      android:scaleType="fitXY" />

    <ImageView
      android:id="@+id/taskbar_group_row_calm"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:contentDescription="从容任务"
      android:scaleType="fitXY" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/taskbar_group_title_urgent"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:textColor="#25262A"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/taskbar_group_when_urgent"
      android:layout_width="wrap_content"
      android:layout_height="34dp"
      android:gravity="center_vertical|end"
      android:paddingStart="5dp"
      android:textColor="#B3352F"
      android:textSize="10sp" />

    <TextView
      android:id="@+id/taskbar_group_label_urgent"
      android:layout_width="30dp"
      android:layout_height="34dp"
      android:gravity="center"
      android:text="○"
      android:textColor="#B3352F"
      android:textSize="16sp" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/taskbar_group_title_soon"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:textColor="#25262A"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/taskbar_group_when_soon"
      android:layout_width="wrap_content"
      android:layout_height="34dp"
      android:gravity="center_vertical|end"
      android:paddingStart="5dp"
      android:textColor="#B58500"
      android:textSize="10sp" />

    <TextView
      android:id="@+id/taskbar_group_label_soon"
      android:layout_width="30dp"
      android:layout_height="34dp"
      android:gravity="center"
      android:text="○"
      android:textColor="#B58500"
      android:textSize="16sp" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/taskbar_group_title_calm"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:textColor="#25262A"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/taskbar_group_when_calm"
      android:layout_width="wrap_content"
      android:layout_height="34dp"
      android:gravity="center_vertical|end"
      android:paddingStart="5dp"
      android:textColor="#2E7D5B"
      android:textSize="10sp" />

    <TextView
      android:id="@+id/taskbar_group_label_calm"
      android:layout_width="30dp"
      android:layout_height="34dp"
      android:gravity="center"
      android:text="○"
      android:textColor="#2E7D5B"
      android:textSize="16sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/taskbar_nearest_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp"
    android:ellipsize="end"
    android:maxLines="2"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:textColor="#6B6B6B"
    android:textSize="10.5sp"
    android:visibility="gone" />
</LinearLayout>
