# 时纪流部署环境变量模板。复制成 .env 后填写，**不要提交**（.gitignore 已忽略 .env / .env.*）。

# ---- 必填 ----
# 数据库密码（首次启动时由容器创建；改这一项要连同数据卷一起重置）
DB_PASSWORD=
# 后端签名密钥：换掉所有令牌即失效，建议 openssl rand -base64 48
JWT_SECRET=
# 平台超管初始账号（库为空时自动创建，登录 Web 后台）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- 短信（spec §3.6）----
# log = 不真发（响应里回显验证码，只适合开发）；aliyun = 阿里云短信
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ---- 地点与地图（spec §5.9）----
# Web 服务 Key（后端搜地点/逆地理，不出服务端）
GEO_AMAP_KEY=
# Web端(JS API) Key 与安全密钥（WebView 画地图，缺了地图白屏）
GEO_AMAP_JS_KEY=
GEO_AMAP_JS_SECURITY_CODE=

# ---- 智能助手「小安」（spec §11 阶段三）----
# 阿里云百炼（通义千问）的 API Key。**留空 = 小安未接入**：接口返回 90002，
# App 显示「还没有接入模型」。在这里填上即可开启，不需要改代码或重新打包。
CHRONOFLOW_AGENT_API_KEY=
# 模型：默认 qwen3.6-flash；想要长上下文 / 多步推理可换 qwen3.7-plus
CHRONOFLOW_AGENT_MODEL=qwen3.6-flash
# 上游地址与生成参数（一般不用改）
CHRONOFLOW_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHRONOFLOW_AGENT_ENABLE_THINKING=false
CHRONOFLOW_AGENT_MAX_TOKENS=600

# 图片识别日程 —— 服务端多模态识别（`POST /ai/events/recognize`，试验用）。
# ⚠️ 这条路会把图片本身发给模型服务，与「图片不出手机」的承诺相反；App 默认不走它
#    （App 是「端侧 OCR → /ai/events/parse-text」）。要面向用户前必须先改隐私政策。
# 留空 = 未接入：该端点返回 90002。想试云端效果就填百炼的兼容地址 + qwen-vl 模型 + Key。
CHRONOFLOW_VISION_BASE_URL=
CHRONOFLOW_VISION_MODEL=
CHRONOFLOW_VISION_API_KEY=
# 关思考流（DashScope）。留空 = 不发这个参数；本地推理服务不认它，云端建议 false
CHRONOFLOW_VISION_ENABLE_THINKING=
# 语音转文字（长按说话）。留空时语音输入提示「未配置」，对话照常可用。
CHRONOFLOW_ASR_API_KEY=
CHRONOFLOW_ASR_MODEL=qwen3-asr-flash

# ---- 可选 ----
# 对外端口（默认 8088；这台机器 80/443 被别的站点占着）
WEB_HOST_PORT=8088
# 后端只绑本机，默认 18080
BACKEND_HOST_PORT=18080
# 节假日数据源（默认 GitHub raw；国内机器可换成 jsDelivr 镜像）
# HOLIDAY_SYNC_BASE_URL=https://cdn.jsdelivr.net/gh/NateScarlet/holiday-cn@master

# ---- 运行环境 ----
# prod = 生产（生产自检会拒绝默认 JWT/超管密码、不回显验证码）；dev = 本地联调
SPRING_PROFILES_ACTIVE=prod

# ---- 节假日同步（spec §4.1.2）----
# 上游数据源。国内机器访问 GitHub 不稳，默认走 jsdelivr 镜像；
# 有自建镜像时换成自己的地址即可。留空 = 用后端内置默认值。
HOLIDAY_SYNC_BASE_URL=https://cdn.jsdelivr.net/gh/NateScarlet/holiday-cn@master

# ---- 极光推送（spec §4.5 / §5.8）----
# 组织日程下发、到点提醒的远程推送。**留空 = 不推送**（本地通知仍然可用）。
# 注意：极光后台填的 Android 包名必须是 com.chronoflow.frontend，否则收不到。
JPUSH_APPKEY=
JPUSH_MASTER_SECRET=
# iOS 走 APNs 生产环境时置 true（用 Ad Hoc / App Store 包）；开发证书置 false
JPUSH_APNS_PRODUCTION=false

# ---- 语音识别（spec §4.1.9.1）----
# 阿里云百炼 qwen3-asr-flash 的接口地址。留空时回退到 CHRONOFLOW_AGENT_BASE_URL，
# 再留空则 App 如实提示「语音识别未配置」，不会假装识别成功。
CHRONOFLOW_ASR_URL=
# 单次语音转写的服务端超时（秒）。语音文件比图片大，给足时间。
CHRONOFLOW_VISION_TIMEOUT_SECONDS=120

# ---- 审核专用固定验证码（应用市场提审时临时开启）----
# 开启后该手机号可用固定验证码登录，便于审核人员免短信进入。
# ⚠️ **审核通过后必须清空这两项并重启后端**，否则等于开了后门。
# 生产自检会在检测到它们时打印 WARN。
CHRONOFLOW_REVIEW_LOGIN_PHONE=
CHRONOFLOW_REVIEW_LOGIN_CODE=

# ---- 应用内更新（spec §4.1.11，由 scripts/publish_apk.sh 自动写入）----
# 这九项由发布脚本填充，一般不用手填。**全部留空 = 不提供更新**（客户端看到 versionCode=0
# 就认为没有新版本，绝不编造版本号）。手动发布时按下表逐项填。
CHRONOFLOW_APP_RELEASE_VERSION_NAME=
# 必须**严格递增**，客户端就拿它比大小；不递增会出现「提示有新版本却装不上」
CHRONOFLOW_APP_RELEASE_VERSION_CODE=0
CHRONOFLOW_APP_RELEASE_APK_URL=
CHRONOFLOW_APP_RELEASE_SIZE_BYTES=0
CHRONOFLOW_APP_RELEASE_SHA=
# 更新说明，用 | 分隔多条（如：修复登录|新增语音输入）
CHRONOFLOW_APP_RELEASE_CHANGELOG=
# true = 强制更新（不给「稍后」）
CHRONOFLOW_APP_RELEASE_FORCE=false
# 低于该 versionCode 的客户端必须更新
CHRONOFLOW_APP_RELEASE_MIN_SUPPORTED_VERSION_CODE=0
# ISO-8601 时间戳，如 2026-11-26T20:00:00+08:00
CHRONOFLOW_APP_RELEASE_PUBLISHED_AT=
